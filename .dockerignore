# =========================================================
# Python cache and build files
# =========================================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# =========================================================
# Virtual environments
# =========================================================
.venv/
venv/
env/
ENV/

# =========================================================
# Environment and secret files
# =========================================================
.env
.env.*
!.env.example

# =========================================================
# Git and editor files
# =========================================================
.git/
.gitignore
.github/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# =========================================================
# Logs and temporary files
# =========================================================
*.log
logs/
tmp/
temp/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================================================
# Notebook and experiment outputs
# =========================================================
.ipynb_checkpoints/
ml/notebook/
notebook/
experiments/
runs/

# =========================================================
# Local data files
# Keep student/survey data out of Docker images.
# Mount data at runtime using docker-compose volumes.
# =========================================================
data/
ml/data/
*.csv
*.xlsx
*.xls
*.jsonl
*.parquet
*.sqlite
*.db

# =========================================================
# Do NOT ignore ML models
# Backend needs these files during runtime:
# ml/models/kmodes_model.pkl
# ml/models/kmodes_feature_columns.json
# ml/models/kmodes_cluster_label_map.json
# =========================================================
!ml/models/
!ml/models/**
!models/
!models/**

# =========================================================
# Frontend static assets should be included
# =========================================================
!web/assets/
!web/assets/**
!assets/
!assets/**

# =========================================================
# Docker files
# =========================================================
docker-compose.override.yml
*.tar

# =========================================================
# OS package/cache files
# =========================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*