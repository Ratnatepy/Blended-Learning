# =========================================================
# Application
# =========================================================
HTTP_PORT=80
APP_ENV=production

# =========================================================
# PostgreSQL Database
# =========================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=blended_learning_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:change_this_to_a_strong_password@postgres:5432/blended_learning_db

# =========================================================
# Backend / FastAPI
# =========================================================
PYTHONPATH=/app:/app/ml/src

MODEL_DIR=/app/ml/models
CONFIG_PATH=/app/ml/config/config.json
SEED_CSV_PATH=/app/ml/data/processed/student_recommendation_reports_current.csv

# =========================================================
# Streamlit Frontend
# =========================================================
API_BASE_URL=http://backend:8000
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# =========================================================
# Admin Login
# Used by Streamlit app if your app has admin login
# =========================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# =========================================================
# OpenRouter / LLM Service
# =========================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Blended Learning Student Recommendation System

# =========================================================
# TranslateKH Service
# =========================================================
TRANSLATE_KH_API_URL=https://www.translate.kh/api
TRANSLATE_KH_USERNAME=your_translatekh_username_here
TRANSLATE_KH_PASSWORD=your_translatekh_password_here

# =========================================================
# KoboToolbox
# Optional, only needed if you fetch survey data from Kobo
# =========================================================
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_TOKEN=your_kobo_token_here
KOBO_ASSET_UID=your_kobo_asset_uid_here
KOBO_EXPORT_FORMAT=xls